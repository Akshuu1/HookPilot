# ==============================================================================
# HookPilot Environment Configuration Template
# Copy this file to .env (or configure in your Cloud Provider dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS Origins: Comma-separated list of allowed frontend origins (supports wildcards)
# In production, set to your Vercel domain: e.g. https://hookpilot.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cookie Policy: 'lax' for same-domain or 'none' for cross-domain production (e.g. Vercel web -> Railway API)
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 2. Database & Cache
# ------------------------------------------------------------------------------
# Local Docker or MongoDB Atlas (e.g. mongodb+srv://user:pass@cluster.mongodb.net/hookpilot)
MONGODB_URI=mongodb://localhost:27017/hookpilot

# Local Redis or Managed Redis / Upstash (e.g. rediss://default:pass@redis.upstash.io:6379)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Worker Delivery Engine
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=10
WORKER_HEALTH_PORT=4002

# SSRF Protection: Set to 'false' (or omit) in production. Only set to 'true' in local test suites.
ALLOW_LOCAL_DESTINATION=false

# ------------------------------------------------------------------------------
# 4. Authentication & Encryption Secrets
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=hookpilot-dev-jwt-access-secret-32-chars-min!
JWT_REFRESH_SECRET=hookpilot-dev-jwt-refresh-secret-32-chars-min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=hookpilot-dev-cookie-secret-key-32-chars!

# AES-256-GCM 32-byte encryption key (64 hex characters) for endpoint secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. Web Frontend Client (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 6. Failure Alerts & Notifications (Phase 17)
# ------------------------------------------------------------------------------
# Mailpit local development SMTP: host localhost, port 1025 (Web UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_FROM=alerts@hookpilot.dev
DASHBOARD_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 7. OAuth Providers (Phase 19: GitHub & Google Login)
# ------------------------------------------------------------------------------
# API public ingress URL for OAuth callback redirects (must match OAuth app registration)
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# GitHub OAuth App: callback URL = ${API_PUBLIC_URL}/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 Client: callback URL = ${API_PUBLIC_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
