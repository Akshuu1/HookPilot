# ==============================================================================
# HookPilot Environment Configuration Template
# Copy this file to .env (or configure in your Cloud Provider dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS Origins: Comma-separated list of allowed frontend origins (supports wildcards)
# In production, set to your Vercel domain: e.g. https://hook-pilot-inky.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cookie Policy: 'lax' for same-domain or 'none' for cross-domain production (e.g. Vercel web -> Render API)
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 2. Database & Cache [REQUIRED IN PRODUCTION]
# ------------------------------------------------------------------------------
# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/hookpilot)
MONGODB_URI=mongodb://localhost:27017/hookpilot

# Redis connection string (e.g. redis://localhost:6379 or rediss://default:pass@redis.render.com:6379)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Encryption [CORE SECRETS - REQUIRED IN PRODUCTION]
# ------------------------------------------------------------------------------
# Secret for signing short-lived JWT access tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=hookpilot-dev-jwt-access-secret-32-chars-min!
JWT_REFRESH_SECRET=hookpilot-dev-jwt-refresh-secret-32-chars-min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=hookpilot-dev-cookie-secret-key-32-chars!

# AES-256-GCM 32-byte encryption key (64 hex characters) for endpoint secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. Worker Delivery Engine
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=10
WORKER_HEALTH_PORT=4002

# SSRF Protection: Set to 'false' (or omit) in production. Only set to 'true' in local test suites.
ALLOW_LOCAL_DESTINATION=false

# ------------------------------------------------------------------------------
# 5. Public URLs & Routing
# ------------------------------------------------------------------------------
# API public ingress URL for OAuth callback redirects (must match OAuth app registration)
# In production, set to your Render API URL: https://hookpilot-api-bfj0.onrender.com
API_PUBLIC_URL=http://localhost:4000

# Frontend URL for OAuth callback redirects and login flows
# In production, set to your Vercel URL: https://hook-pilot-inky.vercel.app
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Failure Alerts & Notifications [OPTIONAL - FEATURE DISABLED IF OMITTED]
# ------------------------------------------------------------------------------
# Email alerts: Leave SMTP_HOST empty if email alerts are not used.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_FROM=alerts@hookpilot.dev

# Slack alerts: Leave empty if Slack alerts are not used.
SLACK_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 7. OAuth Providers [OPTIONAL - FEATURE DISABLED IF OMITTED]
# ------------------------------------------------------------------------------
# GitHub OAuth App: callback URL = ${API_PUBLIC_URL}/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 Client: callback URL = ${API_PUBLIC_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 8. Web Frontend Client (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
